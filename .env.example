# Easiest setup: choose exactly one provider and fill only its key. If more
# than one key is present, set AGENT_MODEL_PROVIDER=openai|anthropic|deepseek.
AGENT_MODEL_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional provider preset overrides: OPENAI_MODEL, ANTHROPIC_MODEL,
# DEEPSEEK_MODEL and the matching *_BASE_URL / context settings.
#
# Official DeepSeek models on https://api.deepseek.com default to a 1,000,000
# working window: the vendor page declares "1M" without an exact integer, so the
# value is adopted as a conservative integer default (capacity status
# "official-default") and is not presented as a verified exact boundary.
# Third-party proxies and unknown model names never inherit it.
# Set a smaller cap explicitly when needed; the manual value wins:
# DEEPSEEK_CONTEXT_WINDOW=65536
#
# Budget counting for official DeepSeek routes uses the heuristic
# "deepseek-text-estimate-v1": estimated_tokens = ceil(utf-8 bytes / 4). It is
# an estimate that may undercount, not a verified upper bound.

# Advanced/custom OpenAI-compatible endpoint. When used, provide all price
# fields below unless the endpoint and exact model match a built-in preset.
# AGENT_MODEL_API_KEY=
# AGENT_MODEL_BASE_URL=https://example.test/v1
# AGENT_MODEL_ID=example-model
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_ATTEMPTS=4
AGENT_MODEL_NETWORK_RETRIES=2
# Only declare capabilities the configured model/protocol has actually verified.
AGENT_MODEL_CAPABILITIES=streaming,tool_calling,json_object
# Rates are USD microunits per 1M tokens (for example $0.30 = 300000).
# AGENT_MODEL_PRICE_UNCACHED_INPUT=
# AGENT_MODEL_PRICE_CACHE_READ=
# AGENT_MODEL_PRICE_CACHE_WRITE=
# AGENT_MODEL_PRICE_OUTPUT=
# AGENT_MODEL_PRICE_REASONING=
# AGENT_MODEL_PRICE_EFFECTIVE_AT=2026-09-12T00:00:00+00:00
# AGENT_MODEL_PRICE_SOURCE_URL=https://provider.example/pricing
# Optional fallback used after retryable primary failures before any output starts.
# AGENT_FALLBACK_MODEL_API_KEY=
# AGENT_FALLBACK_MODEL_BASE_URL=https://api.siliconflow.cn/v1
# AGENT_FALLBACK_MODEL_ID=Qwen/Qwen3.5-122B-A10B
# AGENT_FALLBACK_MODEL_PROVIDER_NAME=siliconflow
# AGENT_FALLBACK_MODEL_TIMEOUT_SECONDS=60
# AGENT_FALLBACK_MODEL_MAX_ATTEMPTS=2
# AGENT_FALLBACK_MODEL_NETWORK_RETRIES=1
# AGENT_FALLBACK_MODEL_CAPABILITIES=streaming,tool_calling,json_object

# PostgreSQL + pgvector. Replace the placeholder password outside source control.
POSTGRES_DB=better_agent
POSTGRES_USER=better_agent
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
APP_PORT=8000
BETTER_AGENT_TURN_WORKER_CONCURRENCY=4
# Estimate fees without stopping work at monetary limits.
BETTER_AGENT_COST_MODE=observe
# Host-side URL for Alembic and maintenance commands. Compose injects its own
# service-network URL into the application container.
DATABASE_URL=postgresql://better_agent:change-this-local-password@127.0.0.1:5432/better_agent

# Long-term memory embeddings. Keep the real key outside source control.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=0.8

# Optional: a local file containing LLM_API_KEY, LLM_BASE_URL, LLM_MODEL_ID.
# LLM_AP_PATH=

# ---------------------------------------------------------------------------
# MCP servers (optional). Better Agent is the MCP *client*: MCP only supplies
# external capabilities, while risk, approval, budget, context and recovery
# stay local. Unset means "no MCP servers" and changes nothing.
#
# BETTER_AGENT_MCP_SERVERS is a single-line JSON array. Every field below is
# read from the local configuration - a remote server never decides its own
# risk level or resource scope.
#
#   server_id          required, unique; becomes the mcp__<server_id>__ prefix
#   transport          "stdio" (default) or "http"
#   command/args/cwd   stdio only; the command to spawn
#   url/headers        http only
#   inherit_env        default true; false starts the child with only `env`
#   env / headers      {"NAME": {"from_env": "VAR"}} reads the real value from
#                      the process environment and never stores it in the file.
#                      A literal string is also accepted.
#   enabled_tools      whitelist. Strongly recommended: without it every tool
#                      the server exposes is injected into the model context.
#   risk               {"tool": "READ"|"WRITE"}; local override of the server's
#                      readOnlyHint. WRITE tools are refused unless
#                      allow_write_tools is true.
#   allow_write_tools  default false
#   default_risk       risk for tools with no explicit entry; default "READ"
#   timeout_seconds    per-request deadline; a write that times out is left
#                      needing reconciliation, never silently retried
#   max_result_bytes   results over the cap are truncated and saved as an
#                      artifact instead of flooding the context
#   cache_ttl_seconds  fallback when the server sends no ttlMs hint
#   resource_allow     {"tool": {"param": ["exact", "allowed", "values"]}};
#                      the model cannot widen its own scope
#   receipt_tools      read-only tools that can prove whether a timed-out
#                      write landed, enabling recovery instead of a guess
#
# Example: the reference time and fetch servers.
# BETTER_AGENT_MCP_SERVERS=[{"server_id":"time","transport":"stdio","command":"python","args":["-m","mcp_server_time","--local-timezone","Asia/Shanghai"],"enabled_tools":["get_current_time","convert_time"],"risk":{"get_current_time":"READ","convert_time":"READ"},"timeout_seconds":20,"max_result_bytes":16384},{"server_id":"fetch","transport":"stdio","command":"python","args":["-m","mcp_server_fetch"],"enabled_tools":["fetch"],"risk":{"fetch":"READ"},"timeout_seconds":30,"max_result_bytes":65536,"resource_allow":{"fetch":{"url":["https://example.com/"]}}}]
#
# Example: a remote HTTP server whose token is kept out of this file.
# BETTER_AGENT_MCP_SERVERS=[{"server_id":"github","transport":"http","url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":{"from_env":"GITHUB_MCP_TOKEN"}},"enabled_tools":["list_issues","get_issue"],"default_risk":"READ","timeout_seconds":30}]
# GITHUB_MCP_TOKEN=
