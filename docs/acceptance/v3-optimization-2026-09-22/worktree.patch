 # Example: a remote HTTP server whose token is kept out of this file.
 # BETTER_AGENT_MCP_SERVERS=[{"server_id":"github","transport":"http","url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":{"from_env":"GITHUB_MCP_TOKEN"}},"enabled_tools":["list_issues","get_issue"],"default_risk":"READ","timeout_seconds":30}]
 # GITHUB_MCP_TOKEN=
+
+# ---------------------------------------------------------------------------
+# V3 learning pipeline (docs: "Better Agent Harness 化自进化 V3")
+# ---------------------------------------------------------------------------
+# The pipeline is the single path from Experience to a promoted asset:
+#   Experience -> JEV decision -> Learning LLM draft -> typed candidate
+#   -> rule eval -> LLM judge -> promotion gate -> canary
+#
+# OFF (default) keeps the pre-V3 deterministic branches in
+# `app/learning_legacy.py` in charge, which is the state the frozen regression
+# baseline was pinned to. SHADOW runs the whole chain but never promotes;
+# ACTIVE lets the gate apply Memory immediately and hand Skill/Behavior to
+# their existing approval and canary lifecycles.
+#
+# A non-OFF value is refused at startup unless both credentials below are
+# present: a half-wired pipeline would silently learn nothing.
+# BETTER_AGENT_LEARNING_V3=SHADOW
+
+# The decision layer. Required whenever BETTER_AGENT_LEARNING_V3 is not OFF.
+# TYPESAFE_API_KEY=
+# TYPESAFE_MODEL=jev-latest
+
+# The Learning LLM and the judge share the agent's routed model gateway. The
+# roles `learning_generator` and `learning_judge` are registered in
+# `model_admin.ROLES` and route through whatever provider AGENT_MODEL_PROVIDER
+# names.
