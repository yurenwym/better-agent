  "regression_found_and_fixed": {
    "test": "tests/test_v2_acceptance.py::test_explicit_plan_modification_becomes_an_approval_gated_tool_call",
    "root_cause": "the artifact-driven pending tool call is created by ConversationService._suspend_artifact_modification, a second creation site that did not persist the execution context and requested the approval before writing the row",
    "symptom": "resume() reported LEGACY_CONTEXT_MISSING; the plan document stayed at version 1",
    "fix": [
      "ManagedTurnWorker._turn_tool_harness(turn): read the persisted turn root back and derive the tool span",
      "store.create(..., execution_context=tool_harness) first, then approvals.request, then attach_approval"
    ]
  },
